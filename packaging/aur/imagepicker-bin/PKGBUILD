# Maintainer: harveyxiacn <harveyxiacn@gmail.com>
#
# Repackages the official .deb from the GitHub Release (built on Ubuntu 22.04, links against the
# system WebKitGTK). `packaging/aur/update.sh <version>` refreshes pkgver and sha256sums.
pkgname=imagepicker-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast, local-first AI photo culling and retouching (prebuilt release)'
arch=('x86_64')
url='https://github.com/harveyxiacn/imagePicker'
license=('Apache-2.0')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'glib2' 'openssl')
optdepends=('uv: runs the optional local AI worker (Python)'
            'nvidia-utils: CUDA acceleration for the AI worker')
provides=('imagepicker')
conflicts=('imagepicker')
options=('!strip' '!debug')
# pkgver cannot contain '-', so pre-releases use '_' (0.2.0_rc1 -> tag v0.2.0-rc1).
_tag="v${pkgver//_/-}"
_debname="imagePicker_${pkgver//_/-}_amd64.deb"
source=("${pkgname}-${pkgver}.deb::${url}/releases/download/${_tag}/${_debname}"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/harveyxiacn/imagePicker/${_tag}/LICENSE")
sha256sums=('SKIP'
            'SKIP')

package() {
  cd "$srcdir"
  rm -rf root && mkdir root
  # A .deb is an ar archive containing data.tar.*; bsdtar (libarchive) reads both layers.
  bsdtar -xf "${pkgname}-${pkgver}.deb" -C root
  bsdtar -xf root/data.tar.* -C root

  # Application files (binary + bundled resources under /usr/lib/<name>).
  install -d "$pkgdir/usr"
  cp -a root/usr/bin root/usr/lib "$pkgdir/usr/" 2>/dev/null || cp -a root/usr/bin "$pkgdir/usr/"

  # Whatever Tauri named the main binary, expose it as `imagepicker`.
  local bin
  bin="$(find "$pkgdir/usr/bin" -maxdepth 1 -type f -perm -u+x | head -n1)"
  [ -n "$bin" ] || { echo "no executable found in the .deb" >&2; return 1; }
  if [ "$(basename "$bin")" != imagepicker ]; then
    ln -s "$(basename "$bin")" "$pkgdir/usr/bin/imagepicker"
  fi

  # Desktop entry (ours, so Exec/Icon are stable regardless of the deb's internal names).
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/imagepicker.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=imagePicker
Comment=Fast, local-first AI photo culling
Exec=imagepicker %F
Icon=imagepicker
Terminal=false
Categories=Graphics;Photography;
StartupWMClass=imagePicker
EOF

  # Icons: copy every hicolor PNG shipped in the deb under the name `imagepicker`.
  local icon size
  while IFS= read -r icon; do
    size="$(basename "$(dirname "$(dirname "$icon")")")"
    install -Dm644 "$icon" "$pkgdir/usr/share/icons/hicolor/${size}/apps/imagepicker.png"
  done < <(find root/usr/share/icons/hicolor -type f -name '*.png' 2>/dev/null)

  install -Dm644 "LICENSE-${pkgver}" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
